# .env / environment — placeholders only, never real secrets
# Copy to backend/.env for local dev. Never commit a filled .env to git.

# --- Backend ---
DATABASE_URL=sqlite:///./gumroad_automation.db
# For PostgreSQL later: postgresql+psycopg://user:password@localhost:5432/gumroad_automation

SECRET_KEY=change-me-to-a-long-random-string
TOKEN_MASTER_KEY=change-me-32-byte-base64-key-for-aes-gcm

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Mailer ($0 mode: console) ---
MAIL_MODE=console
# For real SMTP later:
# MAIL_MODE=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# --- Gumroad OAuth app (optional; manual token mode also works) ---
GUMROAD_CLIENT_ID=
GUMROAD_CLIENT_SECRET=
GUMROAD_REDIRECT_URI=http://localhost:8000/api/v1/gumroad/oauth/callback

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
