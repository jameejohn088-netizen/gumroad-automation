# Gumroad Automation — environment template.
# Copy to .env and fill in real values. NEVER commit .env to git.
# All values below are placeholders.

APP_NAME=GumroadAutomation
DATABASE_URL=sqlite:///./gumroad_app.db
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Generate: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Used for AES-GCM encryption of stored Gumroad tokens.
TOKEN_MASTER_KEY=
MAIL_MODE=disabled
SCHEDULER_ENABLED=true

# Path to the APK file served to verified buyers.
APK_DOWNLOAD_PATH=/path/to/app-debug.apk

# GitHub fine-grained PAT (Gists: read/write, Contents: read/write).
# Only needed for the tunnel-URL auto-update feature.
GITHUB_PAT=
GIST_ID=
GIST_RAW_URL=
